{
  "name": "kasir-seblak",
  "version": "1.0.0",
  "private": true,
  "description": "Kasir Seblak Prasmanan - POS, Inventory, HPP, Financial Reporting",
  "workspaces": [
    "apps/web",
    "apps/api"
  ],
  "scripts": {
    "dev": "npm run dev:api & npm run dev:web",
    "dev:api": "npm run dev -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "build": "npm run build -w apps/web",
    "db:migrate": "npm run db:migrate -w apps/api",
    "db:seed": "npm run db:seed -w apps/api",
    "db:reset": "npm run db:reset -w apps/api",
    "db:studio": "npm run db:studio -w apps/api",
    "test": "npm run test -w apps/api",
    "start": "npm run start -w apps/api",
    "vercel-build": "npm run db:generate -w apps/api && npm run build -w apps/web"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT"
}
